#!/bin/sh

# Get staged .ts/.js files
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|mjs)$')

if [ -z "$STAGED" ]; then
  exit 0
fi

# Format, lint, and apply safe fixes to staged files
echo "$STAGED" | xargs npx biome check --write --no-errors-on-unmatched || exit 1

# Re-stage fixed files
echo "$STAGED" | xargs git add

exit 0
